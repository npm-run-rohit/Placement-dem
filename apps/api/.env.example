# ---- runtime ----
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173
API_PREFIX=api/v1
TZ=Asia/Kolkata

# ---- database (PostgreSQL 16) ----
DATABASE_URL=postgres://placement:placement@localhost:5432/placement
# On ECS the RDS secret arrives as DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD (+ DB_DATABASE) instead of DATABASE_URL
# TLS to RDS, verified against the CA bundle in the image (unset locally)
DB_SSL_CA_PATH=
# Ops metrics from the worker (PLAN 4.6): off locally, emf on ECS (CloudWatch Embedded Metric Format on stdout)
METRICS_DRIVER=off
DB_LOG_QUERIES=false

# ---- messaging: bullmq (local/dev) | aws (EventBridge + SQS + EventBridge Scheduler) ----
MESSAGING_DRIVER=bullmq
REDIS_URL=redis://localhost:6379
AWS_REGION=ap-south-1
AWS_EVENT_BUS_NAME=bimasahayak-bus
AWS_SQS_QUEUE_PREFIX=placement-

# ---- storage: local | s3 ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=bimaplacement-docs-dev
S3_KMS_KEY_ID=

# Malware scan on every stored file (PLAN 4.5). dev = flags only the EICAR test file; production needs clamav (clamd).
MALWARE_SCANNER=dev
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=30000
# Requests per minute per source IP on the public BimaSetu webhook.
# Per-IP limit on BimaSetu webhook calls that fail the signature check
WEBHOOK_RATE_LIMIT_PER_MIN=300
# Proxy hops in front of the API (1 behind the ALB) so rate limits see the caller's IP
TRUST_PROXY=0

# ---- BimaSahayak (umbrella platform: identity, users, notifications, events) ----
# AUTH_MODE=sahayak verifies Sahayak-issued JWTs via JWKS; AUTH_MODE=dev accepts x-dev-user header (local only!)
AUTH_MODE=dev
SAHAYAK_ISSUER=https://sahayak.bimakavach.com
SAHAYAK_AUDIENCE=bimaplacement
SAHAYAK_JWKS_URL=https://sahayak.bimakavach.com/.well-known/jwks.json
SAHAYAK_API_URL=https://sahayak.bimakavach.com/api
SAHAYAK_SERVICE_TOKEN=
SAHAYAK_NOTIFICATIONS_ENABLED=false

# ---- BimaSetu (RM CRM) ----
BIMASETU_MODE=mock
BIMASETU_API_URL=https://bimasetu.bimakavach.com/api
BIMASETU_API_TOKEN=
BIMASETU_WEBHOOK_SECRET=change-me
BIMASETU_WEBHOOK_TOLERANCE_SECONDS=300
BIMASETU_POLLING_FALLBACK=false

# ---- Copycat (external QCR service) ----
COPYCAT_MODE=mock
COPYCAT_ENDPOINT=
COPYCAT_API_KEY=
COPYCAT_TIMEOUT_MS=60000
COPYCAT_MOCK_DELAY_MS=2500

# ---- PM mailbox connector: dev (Mailpit SMTP + no inbound) | gmail | graph ----
MAILBOX_DRIVER=dev
# Shared email layer (MAILBOX_DRIVER=email-layer). The secret is a dev placeholder.
EMAIL_LAYER_URL=http://localhost:3100
EMAIL_LAYER_SECRET=dev-email-layer-secret-change-me
EMAIL_LAYER_TOLERANCE_SECONDS=300
SMTP_HOST=localhost
SMTP_PORT=1025
GOOGLE_SERVICE_ACCOUNT_JSON=
GMAIL_PUBSUB_TOPIC=

# ---- feature flags ----
FEATURE_DEV_SIMULATORS=true
