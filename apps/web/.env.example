# Dev: next dev rewrites /api to the Nest API on :4000 (next.config.ts)
NEXT_PUBLIC_API_BASE=/api/v1
# dev | sahayak  (sahayak = token from the BimaSahayak shell; dev = x-dev-user header)
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_DEV_USER=himani@bimakavach.com|Himani Doshi|placement_head
NEXT_PUBLIC_SAHAYAK_URL=https://sahayak.bimakavach.com
# Dev simulator panels + engine-time chip under `next dev` (never in production builds). false = off.
NEXT_PUBLIC_DEV_TOOLS=true
# Prod inside the BimaSahayak shell: NEXT_PUBLIC_BASE_PATH=/placement (no trailing slash)
